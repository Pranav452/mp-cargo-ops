# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Gmail OAuth2 ────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=          # Generated via OAuth2 playground (see README)
GMAIL_USER=mpcargolille@gmail.com

# ─── Vercel KV (Redis) ───────────────────────────────────────
# Auto-populated by Vercel when you attach a KV store
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Notifications (Resend) ──────────────────────────────────
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=devanshi@manilal.com   # Who gets the critical alerts

# ─── Security ────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-random-string  # Protects the /api/cron endpoint

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mp-cargo-ops.vercel.app
